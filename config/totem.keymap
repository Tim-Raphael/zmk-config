#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE        0
#define SYM         1
#define NAV         2  
#define NUM         3
#define GAME        4 
#define UTIL        5 

&lt {
  flavor = "balanced";
  tapping-term-ms = <160>;
  quick-tap-ms = <175>;
  require-prior-idle-ms = <125>;
};

/ {
  behaviors {
        /// Tap-hold behavior: Caps Word on tap, Layer toggle on hold
        cw_tog: caps_word_layer_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&tog>, <&caps_word>;
        };

        // Index fingers
        hm_shift_l: homerow_mod_shift_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hm_shift_r: homerow_mod_shift_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Middle fingers
        hm_ctrl_l: homerow_mod_ctrl_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <140>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hm_ctrl_r: homerow_mod_ctrl_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <140>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Ring fingers
        hm_alt_l: homerow_mod_alt_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <160>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hm_alt_r: homerow_mod_alt_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <160>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Pinkies
        hm_meta_l: homerow_mod_meta_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hm_meta_r: homerow_mod_meta_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "Base";
            bindings = <
                        &kp Q            &kp W           &kp E             &kp R               &kp T                          &kp Y        &kp U               &kp I             &kp O           &kp P
                        &hm_meta_l LGUI A  &hm_alt_l LALT S  &hm_ctrl_l LCTRL D  &hm_shift_l LSHIFT F  &kp G                          &kp H        &hm_shift_r RSHIFT J  &hm_ctrl_r RCTRL K  &hm_alt_r RALT L  &hm_meta_r RGUI SEMICOLON
            &kp ESC     &kp Z            &kp X           &kp C             &kp V               &kp B                          &kp N        &kp M               &kp COMMA         &kp DOT         &kp SLASH                &cw_tog GAME 0
                                                         &lt NAV TAB       &lt NUM DEL         &lt SYM SPACE                  &lt SYM RET  &lt NUM BSPC        &lt NAV TAB
            >;
        };

        symbol_layer {
            label = "Symbols";
            bindings = <
                        &kp EXCL          &kp AT             &kp HASH             &kp DOLLAR             &kp PERCENT                    &kp CARET    &kp AMPERSAND          &kp ASTERISK         &kp DQT            &kp APOSTROPHE
                        &kp LT            &kp LBRC           &kp LPAR             &kp LBKT               &kp PIPE                       &kp UNDER    &kp RBKT               &kp RPAR             &kp RBRC           &kp GT
            &trans      &kp GRAVE         &kp TILDE          &kp BACKSLASH        &trans                 &trans                         &kp MINUS    &kp PLUS               &kp ASTERISK         &trans             &kp EQUAL         &trans
                                                             &trans               &trans                 &trans                         &trans       &trans                 &trans
            >;
        };

        nav_layer {
            label = "Navigation";
            bindings = <
                        &kp F1            &kp F2           &kp F3             &kp F4               &trans                         &trans       &kp PG_DN              &kp PG_UP          &trans              &trans
                        &kp F5            &kp F6           &kp F7             &kp F8               &trans                         &kp LEFT     &kp DOWN               &kp UP             &kp RIGHT           &trans
            &trans      &kp F9            &kp F10          &kp F11            &kp F12              &trans                         &trans       &trans                 &trans             &trans              &trans    &trans
                                                           &trans             &trans               &trans                         &trans       &trans                 &trans
            >;
        };

        num_layer {
            label = "Numbers";
            bindings = <
                        &trans       &trans      &trans        &trans        &trans                         &kp ASTERISK &kp N7         &kp N8       &kp N9      &kp SLASH 
                        &trans       &trans      &trans        &trans        &trans                         &kp PLUS     &kp N4         &kp N5       &kp N6      &kp N0
            &trans      &trans       &trans      &trans        &trans        &trans                         &kp MINUS    &kp N1         &kp N2       &kp N3      &kp EQUAL    &trans
                                                 &trans        &trans        &trans                         &trans       &trans         &trans
            >;
        };

        game_layer {
            label = "Game";
            bindings = <
                        &kp TAB      &kp N1      &kp N2        &kp N3        &kp N4                         &trans       &trans         &trans       &trans      &trans
                        &kp LSHIFT   &kp A       &kp W         &kp D         &kp R                          &trans       &trans         &trans       &trans      &trans
            &kp ESCAPE  &kp LCTRL    &kp C       &kp S         &kp E         &kp F                          &trans       &trans         &trans       &trans      &trans      &to BASE
                                                 &kp LALT      &kp Q         &kp SPACE                      &trans       &trans         &trans
            >;
        };

        util_layer {
            label = "Utilities";
            bindings = <
                        &bt BT_CLR   &bootloader &trans        &trans        &trans                         &trans       &trans         &trans       &bootloader &trans
                        &trans       &trans      &trans        &trans        &trans                         &trans       &trans         &trans       &trans      &trans
            &trans      &trans       &trans      &trans        &trans        &trans                         &trans       &trans         &trans       &trans      &trans      &trans
                                                 &trans        &trans        &trans                         &trans       &trans         &trans
            >;
        };
    };
};
